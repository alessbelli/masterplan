{
  // Cloudflare Workers config for masterplan. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masterplan",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masterplan",
      // Provisioned via `wrangler d1 create masterplan`. The id is an identifier,
      // not a secret. Local dev and Vitest use a local D1 regardless.
      "database_id": "a068f049-4384-4869-94ea-6d965ff8a583",
      "migrations_dir": "migrations"
    }
  ]
}
